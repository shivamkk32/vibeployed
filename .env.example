# Firebase web config for the contact form.
#
# These values are NOT secrets. Firebase web config is public by design and
# ships in the JS bundle; what protects the database is firestore.rules, which
# only permits create on contactRequests and denies every read. Do not put a
# service account key or any private key in here.
#
# Copy to .env.local for local dev, and add the same values as repository
# variables so the GitHub Actions build can bake them in.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
